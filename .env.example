PORT=5000
MONGODB_URI=mongodb://app_user:replace-with-password@127.0.0.1:27017/remittance?tls=false
JWT_SECRET=
NODE_ENV=development
FAILED_LOGIN_LIMIT=5
FAILED_LOGIN_LOCKOUT_MS=900000
FAILED_LOGIN_DELAY_MS=500
TRANSACTION_SYNC_TIMEOUT_MS=2000
BSC_TESTNET_RPC_URL=https://bsc-testnet-dataseed.bnbchain.org
BSC_RPC_TIMEOUT_MS=30000
API_RESPONSE_SLA_MS=2000
TRANSACTION_RECONCILIATION_ENABLED=true
TRANSACTION_RECONCILIATION_INTERVAL_MS=15000
TRANSACTION_RECONCILIATION_BATCH_SIZE=100
TRANSACTION_RECONCILIATION_RECHECK_MS=3600000
TRANSACTION_RECONCILIATION_MISS_THRESHOLD=3
TRANSACTION_PENDING_RECEIPT_TIMEOUT_MS=1800000
TRANSACTION_EVENT_SYNC_ENABLED=true
TRANSACTION_EVENT_CONFIRMATIONS=3
TRANSACTION_EVENT_BLOCK_BATCH_SIZE=1000
TRANSACTION_EVENT_INITIAL_LOOKBACK_BLOCKS=5000
TRANSACTION_EVENT_REORG_LOOKBACK_BLOCKS=12
REM_CONTRACT_DEPLOYMENT_BLOCK=
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:5000
# Frontend build-time request deadlines (milliseconds). Reads use the regular
# timeout; POST/PUT/PATCH/DELETE operations use the mutation timeout.
VITE_API_TIMEOUT_MS=30000
VITE_API_MUTATION_TIMEOUT_MS=120000
# Production requires HTTPS FRONTEND_URL/API_URL and an authenticated TLS MongoDB URI.
# MONGODB_URI=mongodb+srv://app_user:password@cluster.example/remittance?retryWrites=true&w=majority
BACKUP_ENCRYPTION_KEY=
BACKUP_OUTPUT_DIR=
